# Copie ce fichier vers terraform.tfvars (ignoré par Git) et renseigne le projet.

# L'identifiant du projet Google Cloud dédié à KalmQA.
project_id = "mon-projet-kalmqa"

# Les autres réglages ont une valeur par défaut (voir variables.tf) :
# region       = "europe-west1"
# zone         = "europe-west1-b"
# machine_type = "e2-small"
# domain       = "ytosign.com"
# name_prefix  = "kalmqa"

# L'adresse prévenue par Google quand le site ne répond plus. Sans elle, aucune
# vérification externe n'est créée.
# alert_email = "toi@exemple.fr"

# Durée de conservation des sauvegardes, en jours.
# backup_retention_days = 30
