# Copie ce fichier vers .env (jamais commité) et adapte les valeurs.

# Mot de passe du compte « admin » de Grafana. Choisis le tien.
GRAFANA_ADMIN_PASSWORD=

# Mot de passe de la base Postgres de Ytosign. Obligatoire, lettres et chiffres
# uniquement (il entre dans une URL), par exemple : openssl rand -hex 24
POSTGRES_PASSWORD=

# Mot de passe du compte de supervision de la base (lecture des statistiques
# uniquement). Lettres et chiffres, par exemple : openssl rand -hex 24
POSTGRES_MONITORING_PASSWORD=
