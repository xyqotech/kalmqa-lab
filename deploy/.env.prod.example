# Modèle pour la pile de production (compose.prod.yaml).
# Sur le serveur : copie ce fichier vers .env (jamais commité) et renseigne tout.

# Nom de la pile : il préfixe les conteneurs et les volumes. Ne le change plus une
# fois la pile démarrée, les données sont rangées sous ce nom.
COMPOSE_PROJECT_NAME=kalmqa

# Le nom de domaine de l'instance, sans https://. Il doit pointer vers le serveur.
# Pour répéter le déploiement sur ton poste : localhost
SITE_ADDRESS=sign.example.org

# Facultatif : l'ancienne adresse du site s'il a changé de nom, sans https://. Elle doit
# pointer vers le serveur elle aussi ; ses visiteurs sont redirigés vers SITE_ADDRESS.
# OLD_SITE_ADDRESS=ancien-nom.example.org

# Mots de passe : lettres et chiffres uniquement, par exemple openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_MONITORING_PASSWORD=
GRAFANA_ADMIN_PASSWORD=

# Passe à false une fois les comptes de ton équipe créés.
ALLOW_SIGNUP=true

# E-mails : les signataires reçoivent leur lien et leur code par e-mail, il faut
# donc un vrai serveur SMTP. (« file » les écrit sur le disque : pour répéter.)
MAIL_TRANSPORT=smtp
MAIL_FROM="Ytosign <no-reply@example.org>"
SMTP_URL=smtps://utilisateur:mot-de-passe@smtp.example.org:465
